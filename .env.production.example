# ===== 阿里云 RDS PostgreSQL 生产环境配置 =====
# 将此文件复制为 .env.production 并修改配置
# 注意：不要将此文件提交到 Git！

# ===== 数据库配置（使用 PostgreSQL）=====
USE_SQLITE=false

# 阿里云 RDS PostgreSQL 连接信息
POSTGRES_HOST=rm-xxxxxx.pg.rds.aliyuncs.com  # 替换为你的RDS内网地址
POSTGRES_PORT=5432
POSTGRES_DB=ai_memory
POSTGRES_USER=ai_memory
POSTGRES_PASSWORD=你的强密码_包含大小写数字特殊字符

# ===== 应用配置 =====
SECRET_KEY=生产环境请使用强随机密钥_至少32位
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ===== API密钥 =====
# 通义千问
QWEN_API_KEY=sk-你的通义千问API密钥
# DeepSeek
DEEPSEEK_API_KEY=sk-你的DeepSeekAPI密钥
# 当前使用的模型提供商: 'qwen' 或 'deepseek'
MODEL_PROVIDER=deepseek

# ===== 并发控制配置 =====
# Gunicorn worker配置（建议：CPU核心数 * 2 + 1）
WORKERS=4
GUNICORN_WORKER_CLASS=gevent
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=120

# 数据库连接池配置（根据WORKERS调整，建议：WORKERS * 5）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# API限流配置（可选）
# API_MAX_CONCURRENT=20
# API_REQUESTS_PER_MINUTE=100

# ===== 会话配置 =====
SESSION_TTL_HOURS=168

# ===== 可选：PostgreSQL 直接连接URL（优先级最高）=====
# 如果设置了 DATABASE_URL，则忽略上面的 POSTGRES_* 配置
# DATABASE_URL=postgresql+psycopg2://ai_memory:密码@rm-xxxxxx.pg.rds.aliyuncs.com:5432/ai_memory