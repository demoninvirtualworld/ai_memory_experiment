# ========================================
# AI记忆实验平台 - 生产环境配置
# ========================================
# 重要：部署前请配置所有必要的环境变量
# ========================================

# ============ 应用安全 ============
# 生成强密钥：openssl rand -hex 32
SECRET_KEY=your-very-long-and-random-secret-key-here-minimum-32-chars

# ============ 应用配置 ============
DEBUG=False
APP_PORT=8000
SESSION_TTL_HOURS=168

# ============ 数据库配置 ============
# PostgreSQL数据库连接
POSTGRES_HOST=db
POSTGRES_DB=ai_memory
POSTGRES_USER=ai_memory
# 生成强密码：openssl rand -hex 16
POSTGRES_PASSWORD=your-strong-postgres-password-here
POSTGRES_PORT=5432

# ============ LLM API配置 ============
# 模型提供商：qwen 或 deepseek
MODEL_PROVIDER=qwen

# 通义千问API密钥（从阿里云百炼平台获取）
QWEN_API_KEY=your-qwen-api-key-from-aliyun

# DeepSeek API密钥（备用）
DEEPSEEK_API_KEY=your-deepseek-api-key-backup

# ============ SSL证书配置 ============
# 域名（必须已解析到ECS公网IP）
DOMAIN_NAME=your-domain.com

# Certbot证书邮箱
CERTBOT_EMAIL=admin@your-domain.com

# ============ 生产优化 ============
WORKERS=4
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ========================================
# 可选配置（使用默认值即可）
# ========================================
# 如需使用SQLite开发数据库，取消注释以下行
# USE_SQLITE=false
# DB_PATH=data/experiment.db

# 如需自定义日志级别
# LOG_LEVEL=INFO

# 如需调整waitress线程数
# WAITRESS_THREADS=4