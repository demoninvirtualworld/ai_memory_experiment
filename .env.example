# API keys
QWEN_API_KEY=your-qwen-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Model provider: qwen or deepseek
MODEL_PROVIDER=qwen

# Flask/server config
SECRET_KEY=replace-with-a-strong-random-string
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Session config
SESSION_TTL_HOURS=168

# Database config
# Recommended for cloud / Aliyun ECS: Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_memory
POSTGRES_USER=ai_memory
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional: use an explicit connection string instead of the POSTGRES_* fields
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Optional: local SQLite fallback for quick debugging only
# USE_SQLITE=true
# DB_PATH=data/experiment.db
